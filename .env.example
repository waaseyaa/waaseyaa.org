# Environment variables for waaseyaa.org
#
# Copy to .env for local development (never committed).
# Precedence: process env > .env.local > .env

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# ── Database ───────────────────────────────────────────────────────────────────
WAASEYAA_DB=./storage/waaseyaa.sqlite

# ── Analytics (Umami) ─────────────────────────────────────────────────────────
# Leave empty to disable analytics locally.
UMAMI_TRACKER_URL=
UMAMI_SITE_ID=

# ── Docs ───────────────────────────────────────────────────────────────────────
# Optional: GitHub token for docs fetch (DocsFetcher).
# GITHUB_TOKEN=
