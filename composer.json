{
    "name": "waaseyaa/waaseyaa.org",
    "description": "Marketing site for the Waaseyaa PHP CMS framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "league/commonmark": "^2.8",
        "symfony/dotenv": "^8.0",
        "symfony/yaml": "^7.4",
        "waaseyaa/access": "^0.1",
        "waaseyaa/admin-surface": "^0.1",
        "waaseyaa/ai-agent": "^0.1",
        "waaseyaa/ai-pipeline": "^0.1",
        "waaseyaa/ai-schema": "^0.1",
        "waaseyaa/ai-vector": "^0.1",
        "waaseyaa/analytics": "^0.1",
        "waaseyaa/api": "^0.1",
        "waaseyaa/cache": "^0.1",
        "waaseyaa/cli": "^0.1",
        "waaseyaa/config": "^0.1",
        "waaseyaa/database-legacy": "^0.1",
        "waaseyaa/entity": "^0.1",
        "waaseyaa/entity-storage": "^0.1",
        "waaseyaa/field": "^0.1",
        "waaseyaa/foundation": "^0.1",
        "waaseyaa/graphql": "^0.1",
        "waaseyaa/i18n": "^0.1",
        "waaseyaa/mcp": "^0.1",
        "waaseyaa/media": "^0.1",
        "waaseyaa/menu": "^0.1",
        "waaseyaa/node": "^0.1",
        "waaseyaa/note": "^0.1",
        "waaseyaa/path": "^0.1",
        "waaseyaa/plugin": "^0.1",
        "waaseyaa/queue": "^0.1",
        "waaseyaa/routing": "^0.1",
        "waaseyaa/search": "^0.1",
        "waaseyaa/ssr": "dev-main",
        "waaseyaa/state": "^0.1",
        "waaseyaa/taxonomy": "^0.1",
        "waaseyaa/telescope": "^0.1",
        "waaseyaa/typed-data": "^0.1",
        "waaseyaa/user": "^0.1",
        "waaseyaa/validation": "^0.1",
        "waaseyaa/workflows": "^0.1"
    },
    "repositories": [],
    "autoload": {
        "psr-4": {
            "WaaseyaaOrg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaaseyaaOrg\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "extra": {
        "waaseyaa": {
            "providers": [
                "WaaseyaaOrg\\Provider\\SiteServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "PHP_CLI_SERVER_WORKERS=4 php vendor/bin/waaseyaa serve"
        ],
        "audit-site": "./bin/waaseyaa-audit-site",
        "post-create-project-cmd": [
            "chmod +x bin/waaseyaa-version bin/verify-deploy-rsync bin/waaseyaa-audit-site"
        ]
    }
}
